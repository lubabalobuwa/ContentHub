{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Migrations": {
    "Enabled": true
  },
  "Messaging": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "RabbitMq": {
    "ConnectionString": "amqp://guest:guest@localhost:5672"
  },
  "Jwt": {
    "Issuer": "ContentHub",
    "Audience": "ContentHub",
    "ExpiresMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "EnableResetPassword": false,
    "RequireEmailVerification": true,
    "EmailVerificationTokenHours": 24,
    "PasswordResetTokenHours": 1,
    "BaseUrl": "http://localhost:4200"
  },
  "Smtp": {
    "Host": "smtp-relay.brevo.com",
    "Port": 587,
    "Username": "",
    "FromAddress": "noreply@techcontenthub.live",
    "FromName": "TechContentHub",
    "UseStartTls": true
  }
}
